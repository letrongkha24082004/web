<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="KHA Store - cửa hàng trực tuyến hiện đại, sản phẩm chọn lọc và giao hàng toàn quốc." />
    <title>@ViewData["Title"] - KHA Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="announcement">Miễn phí vận chuyển cho đơn từ 799.000₫ · Đổi trả trong 7 ngày</div>
    <header class="store-header sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span>K</span>KHA STORE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto gap-lg-3">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Cửa hàng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-route-sort="newest">Hàng mới</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="2">Công nghệ</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link admin-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a></li>
                        }
                    </ul>
                    <div class="header-actions">
                        <partial name="_LoginPartial" />
                        <a class="cart-link" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng">Giỏ hàng <span>→</span></a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @if (TempData["Success"] is string success)
        {
            <div class="container pt-3"><div class="alert alert-success alert-dismissible fade show">@success<button class="btn-close" data-bs-dismiss="alert"></button></div></div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container pt-3"><div class="alert alert-danger alert-dismissible fade show">@error<button class="btn-close" data-bs-dismiss="alert"></button></div></div>
        }
        @RenderBody()
    </main>

    <footer class="store-footer">
        <div class="container">
            <div class="row g-4 align-items-start">
                <div class="col-lg-5"><a class="brand brand-light" href="/">KHA STORE</a><p>Những món đồ tốt cho nhịp sống hiện đại.<br />Chọn kỹ, giao nhanh, hỗ trợ tận tâm.</p></div>
                <div class="col-6 col-lg-2"><h6>Khám phá</h6><a href="/">Sản phẩm</a><a href="/?sort=newest">Hàng mới</a><a href="/Cart">Giỏ hàng</a></div>
                <div class="col-6 col-lg-2"><h6>Tài khoản</h6><a href="/Identity/Account/Login">Đăng nhập</a><a href="/Identity/Account/Register">Đăng ký</a><a href="/Orders/MyOrders">Đơn hàng</a></div>
                <div class="col-lg-3"><h6>Liên hệ</h6><p>22T1020634 · Lê Trọng Kha<br />support@khastore.local</p></div>
            </div>
            <div class="footer-bottom">© @DateTime.Now.Year KHA Store. Bài tập website bán hàng ASP.NET Core MVC.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
