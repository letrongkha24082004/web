@model IReadOnlyList<Order>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<section class="page-section"><div class="container narrow-container"><div class="page-title"><span class="eyebrow">TÀI KHOẢN</span><h1>Đơn hàng của tôi</h1></div>@if (Model.Count == 0){<div class="empty-state"><h3>Bạn chưa có đơn hàng</h3><a href="/">Bắt đầu mua sắm →</a></div>}else{<div class="order-list">@foreach(var order in Model){<a class="order-row" asp-action="Details" asp-route-id="@order.Id"><span><small>MÃ ĐƠN</small><b>@order.OrderCode</b></span><span><small>NGÀY ĐẶT</small>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span><span><small>TRẠNG THÁI</small><b class="status-pill status-@order.Status.ToString().ToLower()">@order.Status.ToDisplayName()</b></span><strong>@order.Total.ToString("N0")₫ →</strong></a>}</div>}</div></section>
