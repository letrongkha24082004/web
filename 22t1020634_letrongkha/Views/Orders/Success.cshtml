@model Order
@{ ViewData["Title"] = "Đặt hàng thành công"; }
<section class="page-section"><div class="container"><div class="success-box"><div class="success-mark">✓</div><span class="eyebrow">ĐẶT HÀNG THÀNH CÔNG</span><h1>Cảm ơn bạn đã mua sắm!</h1><p>Đơn hàng <b>@Model.OrderCode</b> đã được tiếp nhận. Chúng tôi sẽ liên hệ xác nhận trong thời gian sớm nhất.</p><div class="success-total">Tổng tiền <strong>@Model.Total.ToString("N0")₫</strong></div><div class="d-flex gap-2 justify-content-center flex-wrap"><a class="btn-primary-store" asp-action="Details" asp-route-id="@Model.Id">Xem đơn hàng →</a><a class="btn-outline-store" href="/">Tiếp tục mua sắm</a></div></div></div></section>
