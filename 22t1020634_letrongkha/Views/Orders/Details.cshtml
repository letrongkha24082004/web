@model Order
@{ ViewData["Title"] = $"Đơn {Model.OrderCode}"; }
<section class="page-section"><div class="container narrow-container"><div class="page-title"><span class="eyebrow">CHI TIẾT ĐƠN HÀNG</span><h1>@Model.OrderCode</h1><p>Đặt lúc @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · <b class="status-pill status-@Model.Status.ToString().ToLower()">@Model.Status.ToDisplayName()</b></p></div><div class="checkout-grid"><div class="card-panel"><h3>Sản phẩm</h3>@foreach(var item in Model.Items){<div class="order-product"><span>@item.ProductName <small>× @item.Quantity</small></span><b>@item.LineTotal.ToString("N0")₫</b></div>}@{ var shipping = Model.Total - Model.Items.Sum(x => x.LineTotal); }<div class="order-product"><span>Phí vận chuyển</span><b>@(shipping > 0 ? $"{shipping:N0}₫" : "Miễn phí")</b></div><div class="order-product total"><span>Tổng cộng</span><b>@Model.Total.ToString("N0")₫</b></div></div><aside class="card-panel"><h3>Giao đến</h3><p><b>@Model.FullName</b><br />@Model.Phone<br />@Model.Address</p>@if (!string.IsNullOrWhiteSpace(Model.Note)){<p><small>Ghi chú:</small><br />@Model.Note</p>}</aside></div></div></section>
