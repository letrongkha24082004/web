@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@ViewData["Title"] · KHA Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <input class="admin-nav-toggle" type="checkbox" id="adminNavToggle" />
    <aside class="admin-sidebar">
        <div class="admin-brand"><span class="admin-brand-mark">K</span><span>KHA <b>ADMIN</b><small>ECOMMERCE SYSTEM</small></span></div>
        <nav class="admin-nav">
            <span class="admin-nav-label">Tổng quan</span>
            <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><span class="nav-symbol">01</span><span>Bảng điều khiển</span></a>
            <span class="admin-nav-label">Quản lý cửa hàng</span>
            <a class="@Active("Products")" asp-area="Admin" asp-controller="Products" asp-action="Index"><span class="nav-symbol">02</span><span>Sản phẩm</span></a>
            <a class="@Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index"><span class="nav-symbol">03</span><span>Danh mục</span></a>
            <a class="@Active("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index"><span class="nav-symbol">04</span><span>Đơn hàng</span></a>
            <span class="admin-nav-label">Hệ thống</span>
            <a href="/swagger" target="_blank"><span class="nav-symbol">05</span><span>Tài liệu API</span></a>
        </nav>
        <div class="admin-sidebar-bottom">
            <div class="admin-profile"><span class="admin-avatar">A</span><span><b>@User.Identity?.Name</b><small>Quản trị viên</small></span></div>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button class="admin-logout" type="submit">Đăng xuất <span>→</span></button>
            </form>
        </div>
    </aside>
    <label class="admin-overlay" for="adminNavToggle"></label>

    <div class="admin-workspace">
        <header class="admin-topbar">
            <div class="admin-topbar-left">
                <label class="admin-menu-button" for="adminNavToggle">☰</label>
                <div><small>KHA STORE / @controller.ToUpperInvariant()</small><strong>@ViewData["Title"]</strong></div>
            </div>
            <div class="admin-topbar-actions">
                <span class="admin-date">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                <a class="admin-store-link" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">Xem cửa hàng ↗</a>
            </div>
        </header>
        <main class="admin-content">
            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert success"><span>✓</span>@success<button type="button" onclick="this.parentElement.remove()">×</button></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="admin-alert error"><span>!</span>@error<button type="button" onclick="this.parentElement.remove()">×</button></div>
            }
            @RenderBody()
        </main>
        <footer class="admin-footer"><span>KHA Store Administration</span><span>22T1020634 · Lê Trọng Kha</span></footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
