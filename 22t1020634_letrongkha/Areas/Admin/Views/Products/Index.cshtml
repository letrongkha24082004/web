@model IReadOnlyList<Product>
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<section class="admin-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">QUẢN TRỊ</span><h1>Sản phẩm</h1><p>@Model.Count sản phẩm trong danh sách hiện tại.</p></div><a class="btn-primary-store" asp-action="Create">+ Thêm sản phẩm</a></div><nav class="admin-tabs"><a asp-controller="Dashboard">Tổng quan</a><a class="active" asp-controller="Products">Sản phẩm</a><a asp-controller="Categories">Danh mục</a><a asp-controller="Orders">Đơn hàng</a></nav><form class="filter-bar admin-filter" method="get"><div class="search-field"><input name="search" value="@ViewBag.Search" placeholder="Tìm tên sản phẩm..." /><button>Tìm</button></div><select name="categoryId" asp-items="ViewBag.CategoryId" onchange="this.form.submit()"><option value="">Tất cả danh mục</option></select></form><div class="admin-panel table-responsive"><table class="admin-table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><div class="table-product">@if(!string.IsNullOrWhiteSpace(item.ImageUrl)){<img src="@item.ImageUrl" alt="" />}<span><b>@item.Name</b><small>#@item.Id · @(item.IsFeatured ? "Nổi bật" : "Thông thường")</small></span></div></td><td>@item.Category?.Name</td><td><b>@item.Price.ToString("N0")₫</b></td><td>@item.Stock</td><td><span class="status-pill @(item.IsActive ? "status-completed" : "status-cancelled")">@(item.IsActive ? "Đang bán" : "Ngừng bán")</span></td><td class="table-actions"><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a><a class="danger-link" asp-action="Delete" asp-route-id="@item.Id">Xóa</a></td></tr>}</tbody></table></div></div></section>
