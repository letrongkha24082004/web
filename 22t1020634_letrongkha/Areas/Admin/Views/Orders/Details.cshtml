@model Order
@{ ViewData["Title"] = $"Đơn {Model.OrderCode}"; }
<section class="admin-section"><div class="container narrow-container"><a class="back-link" asp-action="Index">← Quay lại đơn hàng</a><div class="admin-heading"><div><span class="eyebrow">CHI TIẾT ĐƠN HÀNG</span><h1>@Model.OrderCode</h1><p>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div><span class="status-pill status-@Model.Status.ToString().ToLower()">@Model.Status.ToDisplayName()</span></div><div class="checkout-grid"><div class="admin-panel form-panel"><h3>Sản phẩm</h3>@foreach(var item in Model.Items){<div class="order-product"><span>@item.ProductName <small>× @item.Quantity</small></span><b>@item.LineTotal.ToString("N0")₫</b></div>}@{ var shipping = Model.Total - Model.Items.Sum(x => x.LineTotal); }<div class="order-product"><span>Phí vận chuyển</span><b>@(shipping > 0 ? $"{shipping:N0}₫" : "Miễn phí")</b></div><div class="order-product total"><span>Tổng cộng</span><b>@Model.Total.ToString("N0")₫</b></div></div><aside><div class="admin-panel form-panel mb-3"><h3>Khách hàng</h3><p><b>@Model.FullName</b><br />@Model.CustomerEmail<br />@Model.Phone<br />@Model.Address</p>@if(!string.IsNullOrWhiteSpace(Model.Note)){<p><small>Ghi chú:</small><br />@Model.Note</p>}</div><form class="admin-panel form-panel" asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label">Cập nhật trạng thái</label><select name="status" class="form-select mb-3">@foreach(var status in Enum.GetValues<OrderStatus>()){<option value="@status" selected="@(Model.Status == status)">@status.ToDisplayName()</option>}</select><button class="btn-primary-store w-100">Lưu trạng thái</button></form></aside></div></div></section>
