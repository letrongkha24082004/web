@model IReadOnlyList<Order>
@{ ViewData["Title"] = "Quản lý đơn hàng"; }
<section class="admin-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">QUẢN TRỊ</span><h1>Đơn hàng</h1><p>Theo dõi và cập nhật tiến độ giao hàng.</p></div></div><nav class="admin-tabs"><a asp-controller="Dashboard">Tổng quan</a><a asp-controller="Products">Sản phẩm</a><a asp-controller="Categories">Danh mục</a><a class="active" asp-controller="Orders">Đơn hàng</a></nav><form class="filter-bar admin-filter" method="get"><div class="search-field"><input name="search" value="@ViewBag.Search" placeholder="Mã đơn, tên hoặc email..." /><button>Tìm</button></div><select name="status" onchange="this.form.submit()"><option value="">Tất cả trạng thái</option>@foreach(var status in Enum.GetValues<OrderStatus>()){<option value="@status" selected="@(ViewBag.Status?.ToString() == status.ToString())">@status.ToDisplayName()</option>}</select></form><div class="admin-panel table-responsive"><table class="admin-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Trạng thái</th><th class="text-end">Tổng tiền</th><th></th></tr></thead><tbody>@foreach(var order in Model){<tr><td><b>@order.OrderCode</b></td><td>@order.FullName<br /><small>@order.CustomerEmail</small></td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="status-pill status-@order.Status.ToString().ToLower()">@order.Status.ToDisplayName()</span></td><td class="text-end"><b>@order.Total.ToString("N0")₫</b></td><td><a asp-action="Details" asp-route-id="@order.Id">Xử lý →</a></td></tr>}</tbody></table></div></div></section>
