@model IReadOnlyList<Category>
@{ ViewData["Title"] = "Quản lý danh mục"; }
<section class="admin-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">QUẢN TRỊ</span><h1>Danh mục</h1><p>Sắp xếp sản phẩm thành các nhóm dễ tìm kiếm.</p></div><a class="btn-primary-store" asp-action="Create">+ Thêm danh mục</a></div><nav class="admin-tabs"><a asp-controller="Dashboard">Tổng quan</a><a asp-controller="Products">Sản phẩm</a><a class="active" asp-controller="Categories">Danh mục</a><a asp-controller="Orders">Đơn hàng</a></nav><div class="category-admin-grid">@foreach(var item in Model){<article><div><span class="category-index">@item.Id.ToString("00")</span><span class="status-pill @(item.IsActive ? "status-completed" : "status-cancelled")">@(item.IsActive ? "Hiển thị" : "Đã ẩn")</span></div><h2>@item.Name</h2><p>@item.Description</p><strong>@item.Products.Count sản phẩm</strong><div><a asp-action="Edit" asp-route-id="@item.Id">Chỉnh sửa →</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa danh mục này?')"><button class="danger-link">Xóa</button></form></div></article>}</div></div></section>
