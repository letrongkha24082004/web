@page
@model ShopManager.Areas.Identity.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Đăng ký"; }
<section class="page-section"><div class="container account-container"><div class="page-title"><span class="eyebrow">THÀNH VIÊN MỚI</span><h1>Tạo tài khoản</h1><p>Đăng ký để đặt hàng và theo dõi trạng thái giao hàng.</p></div><form method="post" class="card-panel checkout-form"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="form-floating mb-3"><input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="email@example.com" /><label asp-for="Input.Email"></label><span asp-validation-for="Input.Email" class="text-danger"></span></div><div class="form-floating mb-3"><input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Mật khẩu" /><label asp-for="Input.Password"></label><span asp-validation-for="Input.Password" class="text-danger"></span></div><div class="form-floating mb-3"><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" /><label asp-for="Input.ConfirmPassword"></label><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div><button class="btn-primary-store w-100" type="submit">Tạo tài khoản →</button><p class="text-center mt-3 mb-0">Đã có tài khoản? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl"><b>Đăng nhập</b></a></p></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
