@page
@model ShopManager.Areas.Identity.Pages.Account.LoginModel
@{ ViewData["Title"] = "Đăng nhập"; }
<section class="page-section"><div class="container account-container"><div class="page-title"><span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span><h1>Đăng nhập</h1><p>Sử dụng tài khoản của bạn để mua hàng hoặc quản trị cửa hàng.</p></div><form method="post" class="card-panel checkout-form"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="form-floating mb-3"><input asp-for="Input.UserName" class="form-control" autocomplete="username" placeholder="Tên đăng nhập" /><label asp-for="Input.UserName"></label><span asp-validation-for="Input.UserName" class="text-danger"></span></div><div class="form-floating mb-3"><input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Mật khẩu" /><label asp-for="Input.Password"></label><span asp-validation-for="Input.Password" class="text-danger"></span></div><div class="form-check mb-4"><input asp-for="Input.RememberMe" class="form-check-input" /><label asp-for="Input.RememberMe" class="form-check-label"></label></div><button class="btn-primary-store w-100" type="submit">Đăng nhập →</button><p class="text-center mt-3 mb-0">Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"><b>Đăng ký</b></a></p></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
