@model CategoryIndexViewModel
@{
    ViewData["Title"] = "Danh mục";
    var firstItem = Model.TotalItems == 0
        ? 0
        : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var lastItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
}

<div class="d-flex flex-column flex-xl-row align-items-xl-center gap-3 mb-3">
    <h1 class="h2 mb-0 text-nowrap">
        <i class="bi bi-tags me-2" aria-hidden="true"></i>Danh mục
    </h1>

    <div class="d-flex flex-column flex-md-row gap-2 ms-xl-auto">
        <form asp-action="Index" method="get" class="list-search-form" role="search">
            <div class="input-group">
                <span class="input-group-text bg-white" aria-hidden="true">
                    <i class="bi bi-search"></i>
                </span>
                <input type="search"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="form-control"
                       placeholder="Tìm tên danh mục..."
                       aria-label="Tìm kiếm danh mục" />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                        <span class="visually-hidden">Xóa bộ lọc</span>
                    </a>
                }
            </div>
        </form>

        @if (User.IsInRole(RoleNames.Admin))
        {
            <a asp-action="Create" class="btn btn-primary text-nowrap">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Tạo danh mục
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success d-flex align-items-center" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <p class="text-muted">
        <i class="bi bi-funnel me-1" aria-hidden="true"></i>
        Tìm thấy <strong>@Model.TotalItems</strong> danh mục cho “<strong>@Model.SearchTerm</strong>”.
    </p>
}

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-light border text-center py-5" role="status">
        <i class="bi bi-tags fs-1 d-block mb-2 text-secondary" aria-hidden="true"></i>
        <h2 class="h5">Không tìm thấy danh mục</h2>
        <p class="text-muted mb-3">
            @(string.IsNullOrEmpty(Model.SearchTerm)
                ? "Tạo danh mục đầu tiên để phân loại bài viết."
                : "Hãy thử một từ khóa khác hoặc xóa bộ lọc tìm kiếm.")
        </p>
        @if (string.IsNullOrEmpty(Model.SearchTerm) && User.IsInRole(RoleNames.Admin))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Tạo danh mục
            </a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Xóa bộ lọc
            </a>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col" style="width: 8rem">STT</th>
                    <th scope="col">Tên danh mục</th>
                    <th scope="col" class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Model.Categories.Count; index++)
                {
                    var category = Model.Categories[index];
                    var sequenceNumber = ((Model.CurrentPage - 1) * Model.PageSize) + index + 1;

                    <tr>
                        <td>@sequenceNumber</td>
                        <td>
                            <i class="bi bi-tag me-2 text-primary" aria-hidden="true"></i>@category.Name
                        </td>
                        <td class="text-end text-nowrap">
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1" aria-hidden="true"></i>Xóa
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mt-3">
        <small class="text-muted">
            Hiển thị @firstItem–@lastItem trong tổng số @Model.TotalItems danh mục
        </small>

        @if (Model.TotalPages > 1)
        {
            var startPage = Math.Max(1, Model.CurrentPage - 2);
            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

            <nav aria-label="Phân trang danh mục">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : string.Empty)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           aria-label="Trang trước"
                           tabindex="@(!Model.HasPreviousPage ? "-1" : null)">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchTerm="@Model.SearchTerm">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)"
                            aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@pageNumber"
                               asp-route-searchTerm="@Model.SearchTerm">@pageNumber</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@Model.TotalPages"
                               asp-route-searchTerm="@Model.SearchTerm">@Model.TotalPages</a>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : string.Empty)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           aria-label="Trang sau"
                           tabindex="@(!Model.HasNextPage ? "-1" : null)">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
