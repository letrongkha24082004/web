@model Post
@{
    ViewData["Title"] = "Xóa bài viết";
}

<div class="card border-danger">
    <div class="card-header text-bg-danger">
        <h1 class="h4 mb-0">Xác nhận xóa bài viết</h1>
    </div>
    <div class="card-body">
        <p>Bạn có chắc muốn xóa bài viết <strong>@Model.Title</strong>?</p>
        <p class="text-muted mb-0">Thao tác này không thể hoàn tác.</p>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1" aria-hidden="true"></i>Xóa
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Hủy
            </a>
        </form>
    </div>
</div>
