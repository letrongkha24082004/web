@model PostListViewModel
@{
    ViewData["Title"] = "Bài viết";
    var firstItem = Model.TotalItems == 0
        ? 0
        : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var lastItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
}

<div class="posts-toolbar d-flex flex-column flex-xl-row align-items-xl-center gap-3 mb-3">
    <h1 class="h2 mb-0 text-nowrap">
        <i class="bi bi-journal-text me-2" aria-hidden="true"></i>Danh sách bài viết
    </h1>

    <div class="d-flex flex-column flex-md-row gap-2 ms-xl-auto">
        <form asp-action="Index" method="get" class="list-search-form" role="search">
            <div class="input-group">
                <span class="input-group-text bg-white" aria-hidden="true">
                    <i class="bi bi-search"></i>
                </span>
                <input type="search"
                       name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Tìm theo tiêu đề"
                       aria-label="Tìm kiếm bài viết" />
                <select name="sort"
                        class="form-select"
                        aria-label="Sắp xếp bài viết">
                    <option value="" selected="@(Model.Sort is null)">Mới nhất</option>
                    <option value="oldest" selected="@(Model.Sort == "oldest")">Cũ nhất</option>
                    <option value="title" selected="@(Model.Sort == "title")">Theo tiêu đề</option>
                    <option value="popular" selected="@(Model.Sort == "popular")">Nhiều lượt xem</option>
                </select>
                <select name="tagId" class="form-select" aria-label="Lọc theo thẻ">
                    <option value="">Tất cả thẻ</option>
                    @foreach (var tag in Model.AvailableTags)
                    {
                        <option value="@tag.Id" selected="@(Model.TagId == tag.Id)">#@tag.Name</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(Model.Search) || Model.Sort is not null || Model.TagId.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa điều kiện">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                        <span class="visually-hidden">Xóa điều kiện tìm kiếm và sắp xếp</span>
                    </a>
                }
            </div>
        </form>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary text-nowrap">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Tạo bài viết
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success d-flex align-items-center" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Search))
{
    <p class="text-muted">
        <i class="bi bi-funnel me-1" aria-hidden="true"></i>
        Tìm thấy <strong>@Model.TotalItems</strong> bài viết có tiêu đề chứa “<strong>@Model.Search</strong>”.
    </p>
}

@if (Model.Posts.Count == 0)
{
    <div class="alert alert-light border text-center py-5" role="status">
        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary" aria-hidden="true"></i>
        <h2 class="h5">Không tìm thấy bài viết</h2>
        <p class="text-muted mb-3">
            @(string.IsNullOrEmpty(Model.Search)
                ? "Hãy tạo bài viết đầu tiên để bắt đầu."
                : "Hãy thử một từ khóa khác hoặc xóa bộ lọc tìm kiếm.")
        </p>
        @if (string.IsNullOrEmpty(Model.Search) && User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Tạo bài viết
            </a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Xóa bộ lọc
            </a>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Tác giả</th>
                    <th>Danh mục</th>
                    <th>Ngày đăng</th>
                    <th>Trạng thái</th>
                    <th>Lượt xem</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model.Posts)
                {
                    <tr>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@post.Id"
                               class="link-dark fw-semibold text-decoration-none">
                                @post.Title
                            </a>
                        </td>
                        <td>@post.Author</td>
                        <td>
                            @if (post.Category is null)
                            {
                                <span class="text-muted">Chưa phân loại</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light border">
                                    <i class="bi bi-tag me-1" aria-hidden="true"></i>@post.Category.Name
                                </span>
                            }
                        </td>
                        <td class="text-nowrap">@post.PublishedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge @(post.IsPublished ? "text-bg-success" : "text-bg-secondary")">
                                <i class="bi @(post.IsPublished ? "bi-check-circle" : "bi-pencil") me-1" aria-hidden="true"></i>
                                @(post.IsPublished ? "Đã xuất bản" : "Bản nháp")
                            </span>
                        </td>
                        <td>@post.ViewCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1" aria-hidden="true"></i>Xem
                            </a>
                            @if (User.IsInRole(RoleNames.Admin) ||
                                 User.IsInRole(RoleNames.Editor) ||
                                 User.IsInRole(RoleNames.User))
                            {
                                <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Sửa
                                </a>
                            }
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1" aria-hidden="true"></i>Xóa
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mt-3">
        <small class="text-muted">
            Hiển thị @firstItem–@lastItem trong tổng số @Model.TotalItems bài viết
        </small>

        @if (Model.TotalPages > 1)
        {
            var startPage = Math.Max(1, Model.CurrentPage - 2);
            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

            <nav aria-label="Phân trang bài viết">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : string.Empty)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.CurrentPage - 1)"
                           asp-route-search="@Model.Search"
                           asp-route-sort="@Model.Sort"
                           asp-route-tagId="@Model.TagId"
                           aria-label="Trang trước"
                           tabindex="@(!Model.HasPreviousPage ? "-1" : null)">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="1"
                               asp-route-search="@Model.Search"
                               asp-route-sort="@Model.Sort"
                               asp-route-tagId="@Model.TagId">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)"
                            aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@pageNumber"
                               asp-route-search="@Model.Search"
                               asp-route-sort="@Model.Sort"
                               asp-route-tagId="@Model.TagId">@pageNumber</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@Model.TotalPages"
                               asp-route-search="@Model.Search"
                               asp-route-sort="@Model.Sort"
                               asp-route-tagId="@Model.TagId">@Model.TotalPages</a>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : string.Empty)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.CurrentPage + 1)"
                           asp-route-search="@Model.Search"
                           asp-route-sort="@Model.Sort"
                           asp-route-tagId="@Model.TagId"
                           aria-label="Trang sau"
                           tabindex="@(!Model.HasNextPage ? "-1" : null)">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
