@model PostFormViewModel
@{
    ViewData["Title"] = "Tạo bài viết";
}

<h1 class="h2 mb-3"><i class="bi bi-file-earmark-plus me-2" aria-hidden="true"></i>Tạo bài viết</h1>

<form asp-action="Create" method="post">
    <partial name="_FormFields" model="Model" />
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-floppy me-1" aria-hidden="true"></i>Lưu bài viết
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Hủy
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
