@model Category
@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h2 mb-4">
                    <i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Chỉnh sửa danh mục
                </h1>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input asp-for="Id" type="hidden" />
                    <partial name="_FormFields" model="Model" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1" aria-hidden="true"></i>Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
