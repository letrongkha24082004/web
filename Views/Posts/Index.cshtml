@model List<BlogManager_LeTrongKha.Models.Post>
@{
    ViewData["Title"] = "Bài viết";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Danh sách bài viết</h1>
        <p class="text-muted mb-0">Dữ liệu được lưu bằng SQLite và Entity Framework Core.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm bài viết</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">Chưa có bài viết. Hãy tạo bài viết đầu tiên.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Tiêu đề</th>
                    <th>Ngày đăng</th>
                    <th>Trạng thái</th>
                    <th>Tác giả</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var post in Model)
            {
                <tr>
                    <td>@post.Title</td>
                    <td>@post.PublishedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <span class="badge @(post.IsPublished ? "text-bg-success" : "text-bg-secondary")">
                            @(post.IsPublished ? "Đã xuất bản" : "Nháp")
                        </span>
                    </td>
                    <td>@post.Author</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@post.Id">Chi tiết</a>
                        <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@post.Id">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@post.Id">Xóa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
