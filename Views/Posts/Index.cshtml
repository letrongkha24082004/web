@model List<BlogManager_LeTrongKha.Models.Post>
@{
    ViewData["Title"] = "Bài viết";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Danh sách bài viết</h1>
        <p class="text-muted mb-0">Dự án BlogManager_LeTrongKha</p>
    </div>
    <span class="badge text-bg-primary">@Model.Count bài</span>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Tiêu đề</th>
                <th>Ngày đăng</th>
                <th>Trạng thái</th>
                <th>Tác giả</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var post in Model)
        {
            <tr>
                <td>@post.Title</td>
                <td>@post.PublishedAt.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (post.IsPublished)
                    {
                        <span class="badge text-bg-success">Đã xuất bản</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Nháp</span>
                    }
                </td>
                <td>@post.Author</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary"
                       asp-action="Details"
                       asp-route-id="@post.Id">Xem chi tiết</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
