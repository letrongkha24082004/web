@model BlogManager_LeTrongKha.Models.Post
@{
    ViewData["Title"] = "Chi tiết bài viết";
}

<article>
    <h1>@Model.Title</h1>
    <p class="text-muted">
        @Model.Author · @Model.PublishedAt.ToString("dd/MM/yyyy") · @Model.ViewCount lượt xem
    </p>
    <hr />
    <p class="lead" style="white-space: pre-line">@Model.Content</p>
    <span class="badge @(Model.IsPublished ? "text-bg-success" : "text-bg-secondary")">
        @(Model.IsPublished ? "Đã xuất bản" : "Nháp")
    </span>
</article>

<div class="mt-4 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Xóa</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>
