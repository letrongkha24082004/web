@model PostFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<h1 class="h2 mb-3"><i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Chỉnh sửa bài viết</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <partial name="_FormFields" model="Model" />
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-floppy me-1" aria-hidden="true"></i>Lưu thay đổi
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Hủy
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
