@model BlogManager_LeTrongKha.ViewModels.PostCreateViewModel
@{
    ViewData["Title"] = "Thêm bài viết";
}

<h1>Thêm bài viết</h1>
<p class="text-muted">Nhập thông tin và lưu bài viết vào SQLite.</p>

<form asp-action="Create" method="post" class="mt-4" style="max-width: 48rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" class="form-control" rows="7"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PublishedAt" class="form-label"></label>
            <input asp-for="PublishedAt" class="form-control" />
            <span asp-validation-for="PublishedAt" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="ViewCount" class="form-label"></label>
        <input asp-for="ViewCount" class="form-control" />
        <span asp-validation-for="ViewCount" class="text-danger"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="IsPublished" class="form-check-input" />
        <label asp-for="IsPublished" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Lưu bài viết</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
